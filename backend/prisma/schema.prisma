generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum RemediationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  remediations RemediationAction[]
  auditLogs    AuditLog[]
}

model Device {
  id            String       @id @default(uuid())
  hostname      String       @unique
  ipAddress     String
  macAddress    String       @unique
  os            String
  osVersion     String
  status        DeviceStatus @default(OFFLINE)
  lastHeartbeat DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  telemetry    Telemetry[]
  alerts       Alert[]
  remediations RemediationAction[]

  @@index([status])
}

model Telemetry {
  id          String   @id @default(uuid())
  deviceId    String
  cpuUsage    Float
  memoryUsage Float
  diskUsage   Float
  timestamp   DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp(sort: Desc)])
}

model Alert {
  id          String        @id @default(uuid())
  deviceId    String
  title       String
  description String
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  device       Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  remediations RemediationAction[]

  @@index([deviceId, status])
}

model RemediationAction {
  id         String            @id @default(uuid())
  deviceId   String
  alertId    String?
  actionType String // e.g., "CLEANUP_TEMP_FILES", "RESTART_SERVICE"
  status     RemediationStatus @default(PENDING_APPROVAL)
  executedBy String? // User ID who approved/triggered
  outputLog  String? // Simulation output/logs
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  alert  Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  user   User?  @relation(fields: [executedBy], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // e.g., "REMEDIATION_APPROVED", "DEVICE_REGISTERED"
  resource   String // e.g., "Device", "RemediationAction"
  resourceId String?
  details    String? // JSON string or summary of parameters
  ipAddress  String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([userId])
}
